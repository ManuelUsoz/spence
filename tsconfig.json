{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@ui/button": ["./src/app/ui/button/src/index.ts"],
      "@ui/utils": ["./src/app/ui/utils/src/index.ts"],
      "@ui/sidebar": ["./src/app/ui/sidebar/src/index.ts"],
      "@ui/input": ["./src/app/ui/input/src/index.ts"],
      "@ui/separator": ["./src/app/ui/separator/src/index.ts"],
      "@ui/sheet": ["./src/app/ui/sheet/src/index.ts"],
      "@ui/skeleton": ["./src/app/ui/skeleton/src/index.ts"],
      "@ui/tooltip": ["./src/app/ui/tooltip/src/index.ts"],
      "@ui/dialog": ["./src/app/ui/dialog/src/index.ts"],
      "@ui/scroll-area": ["./src/app/ui/scroll-area/src/index.ts"],
      "@ui/typography": ["./src/app/ui/typography/src/index.ts"],
      "@ui/trace": ["./src/app/ui/trace/src/index.ts"],
      "@ui/sonner": ["./src/app/ui/sonner/src/index.ts"],
      "@ui/toast": ["./src/app/ui/toast/src/index.ts"],
      "@ui/progress": ["./src/app/ui/progress/src/index.ts"],
      "@ui/textarea": ["./src/app/ui/textarea/src/index.ts"],
      "@ui/native-select": ["./src/app/ui/native-select/src/index.ts"],
      "@ui/switch": ["./src/app/ui/switch/src/index.ts"],
      "@ui/toggle-group": ["./src/app/ui/toggle-group/src/index.ts"],
      "@ui/toggle": ["./src/app/ui/toggle/src/index.ts"],
      "@ui/label": ["./src/app/ui/label/src/index.ts"],
      "@ui/dropdown-menu": ["./src/app/ui/dropdown-menu/src/index.ts"],
      "@ui/kbd": ["./src/app/ui/kbd/src/index.ts"],
      "@ui/context-menu": ["./src/app/ui/context-menu/src/index.ts"],
      "@ui/alert-dialog": ["./src/app/ui/alert-dialog/src/index.ts"],
      "@ui/agent-tile": ["./src/app/ui/agent-tile/index.ts"],
      "@ui/pill": ["./src/app/ui/pill/index.ts"],
      "@ui/activity-mark": ["./src/app/ui/activity-mark/index.ts"],
      "@ui/command": ["./src/app/ui/command/src/index.ts"],
      "@ui/input-group": ["./src/app/ui/input-group/src/index.ts"],
      "@ui/badge": ["./src/app/ui/badge/src/index.ts"],
      "@ui/table": ["./src/app/ui/table/src/index.ts"],
      "@ui/code-block": ["./src/app/ui/code-block/src/index.ts"],
      "@ui/breadcrumb": ["./src/app/ui/breadcrumb/src/index.ts"],
      "@ui/select": ["./src/app/ui/select/src/index.ts"],
      "@ui/autocomplete": ["./src/app/ui/autocomplete/src/index.ts"],
      "@ui/popover": ["./src/app/ui/popover/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
