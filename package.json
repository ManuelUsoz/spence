{
  "name": "spence",
  "version": "0.1.0-rc.3",
  "description": "Desktop app built with Electron and an Angular renderer.",
  "author": "",
  "main": "dist-electron/main.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ng": "ng",
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "ng serve --port 4200",
    "dev:es": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer:es\" \"npm:dev:electron\"",
    "dev:renderer:es": "ng serve --port 4200 -c es",
    "dev:electron": "wait-on http-get://localhost:4200 && npm run build:electron && cross-env ELECTRON_RENDERER_URL=http://localhost:4200 electron .",
    "start": "npm run dev",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "ng build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:e2e": "ng build -c e2e-fast && npm run build:electron",
    "preview": "npm run build && electron .",
    "package": "npm run build && electron-forge make",
    "typecheck": "npm run typecheck:electron && npm run typecheck:app && npm run typecheck:spec",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/electron.tsbuildinfo",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/spec.tsbuildinfo",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier --write \"{src,electron,scripts,e2e}/**/*.{ts,html,css,mjs}\"",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier/.prettiercache \"{src,electron,scripts,e2e}/**/*.{ts,html,css,mjs}\"",
    "test": "ng test --watch=false",
    "test:ui": "ng test -c browser --watch=false",
    "test:electron": "vitest run electron scripts --testTimeout=30000 --passWithNoTests --exclude \".claude/**\" --exclude \".worktrees/**\" --exclude \"**/node_modules/**\" --exclude \"electron/sessions/sessions*.spec.ts\" --exclude \"electron/lan/parity.spec.ts\" --exclude \"electron/source-control/git-discard.spec.ts\" --exclude \"electron/source-control/git-actions.spec.ts\" --exclude \"electron/source-control/git-commits.spec.ts\" --exclude \"electron/rpc/source-control-transport.spec.ts\" --exclude \"electron/worktrees/worktrees-core.spec.ts\"",
    "test:electron:full": "vitest run electron scripts --testTimeout=30000 --passWithNoTests --exclude \".claude/**\" --exclude \".worktrees/**\" --exclude \"**/node_modules/**\"",
    "i18n:merge": "node scripts/i18n.mjs merge",
    "i18n:check": "node scripts/i18n.mjs check",
    "verify": "node scripts/verify.mjs",
    "check": "node scripts/verify.mjs",
    "e2e": "node scripts/e2e/run-local.mjs --smoke",
    "e2e:affected": "node scripts/e2e/run-local.mjs --affected",
    "e2e:fast": "playwright test",
    "e2e:visible": "cross-env SPENCE_E2E_VISIBLE=1 SPENCE_E2E_WORKERS=1 playwright test",
    "e2e:full": "npm run build && playwright test",
    "e2e:update": "npm run build && playwright test --update-snapshots",
    "package:dir": "npm run build && electron-forge package"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.6.0",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@peculiar/x509": "^3.1.0",
    "@spartan-ng/brain": "^1.9.0",
    "bonjour-service": "^1.4.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "effect": "4.1.3",
    "electron-squirrel-startup": "^1.0.1",
    "goeist": "0.1.0",
    "ngx-scrollbar": "^19.1.5",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "rxjs": "~7.8.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.9.1",
    "unified": "^11.0.5",
    "ws": "^8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/localize": "^22.2.5",
    "@effect/vitest": "4.1.3",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@playwright/test": "^1.65.0",
    "@spartan-ng/cli": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/angular": "^19.6.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^5.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "effect": "$effect"
  }
}
